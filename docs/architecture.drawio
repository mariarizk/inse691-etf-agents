<mxfile host="app.diagrams.net" agent="Cursor" version="21.0.0">
  <diagram name="MAS Architecture" id="mas-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0" darkMode="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="QQQ Multi-Agent Trading System: Five-Agent Architecture with LLM Guardrails" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="prices" value="&lt;b&gt;QQQ price data&lt;/b&gt;&lt;br&gt;data/QQQ.csv&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;EODHD, FMP, Alpha Vantage, CSV&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="news" value="&lt;b&gt;Marketaux news&lt;/b&gt;&lt;br&gt;latest QQQ headlines" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="technical" value="&lt;b&gt;1. Technical Agent&lt;/b&gt; (rules)&lt;br&gt;10 / 30-day moving averages&lt;br&gt;bullish | neutral | bearish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sentiment" value="&lt;b&gt;2. Sentiment Agent&lt;/b&gt; (LLM)&lt;br&gt;Positive | Neutral | Negative&lt;br&gt;+ input/output guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="&lt;b&gt;3. Risk Agent&lt;/b&gt; (LLM)&lt;br&gt;Low | Medium | High&lt;br&gt;+ input/output guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="400" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="guard" value="&lt;b&gt;LLM Guardrails&lt;/b&gt;&lt;br&gt;Reject empty/short articles&lt;br&gt;JSON-only responses&lt;br&gt;Label whitelist&lt;br&gt;Confidence 0–100&lt;br&gt;Pipeline try/except" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="280" y="520" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="agentlog" value="&lt;b&gt;Agent communication log&lt;/b&gt;&lt;br&gt;data/agent_log.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="blackboard" value="&lt;b&gt;Blackboard&lt;/b&gt;&lt;br&gt;shared memory for&lt;br&gt;agent-to-agent communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="580" y="230" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="&lt;b&gt;4. Decision Agent&lt;/b&gt; (rules)&lt;br&gt;ignores LLM outputs below 60&lt;br&gt;confidence; BUY | HOLD | SELL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="230" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="conversation" value="&lt;b&gt;5. Conversation Agent&lt;/b&gt; (LLM)&lt;br&gt;explains the decision and&lt;br&gt;answers follow-up questions&lt;br&gt;+ consistency / length guards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="860" y="420" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="backtest" value="&lt;b&gt;Backtester + metrics&lt;/b&gt;&lt;br&gt;daily decisions vs QQQ buy-and-hold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="230" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;website / chat UI, FastAPI,&lt;br&gt;analysis report and agent log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="420" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Design notes&lt;/b&gt; Blue = rule-based agent, purple = LLM agent, red = guardrails. The blackboard is communication only (not an agent). Conversation Agent replaces the former Explanation Agent so the system stays within the course limit of five agents. In backtests, Sentiment/Risk use price rules and Conversation is skipped." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1300" height="70" as="geometry" />
        </mxCell>

