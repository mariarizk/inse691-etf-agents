<mxfile host="app.diagrams.net" agent="Cursor" version="21.0.0">
  <diagram name="MAS Architecture" id="mas-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="900" math="0" shadow="0" darkMode="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="QQQ Multi-Agent Trading System: Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Data source -->
        <mxCell id="data" value="&lt;b&gt;QQQ price data&lt;/b&gt;&lt;br&gt;data/QQQ.csv&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;EODHD, FMP, Alpha Vantage,&lt;br&gt;Yahoo, CSV fallback&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="160" height="130" as="geometry" />
        </mxCell>

        <!-- Analyst agents -->
        <mxCell id="analysts" value="Rule-based analyst agents" style="swimlane;fontStyle=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="240" height="340" as="geometry" />
        </mxCell>
        <mxCell id="technical" value="&lt;b&gt;Technical Agent&lt;/b&gt;&lt;br&gt;10 / 30-day moving averages&lt;br&gt;bullish | neutral | bearish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="analysts">
          <mxGeometry x="20" y="40" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sentiment" value="&lt;b&gt;Sentiment Agent&lt;/b&gt;&lt;br&gt;latest daily return&lt;br&gt;positive | neutral | negative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="analysts">
          <mxGeometry x="20" y="140" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="&lt;b&gt;Risk Agent&lt;/b&gt;&lt;br&gt;20-day volatility&lt;br&gt;low | medium | high" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="analysts">
          <mxGeometry x="20" y="240" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Blackboard -->
        <mxCell id="blackboard" value="&lt;b&gt;Blackboard&lt;/b&gt;&lt;br&gt;shared memory for&lt;br&gt;agent-to-agent communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="570" y="195" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Decision agent -->
        <mxCell id="decision" value="&lt;b&gt;Decision Agent&lt;/b&gt;&lt;br&gt;rule-based combination&lt;br&gt;BUY | HOLD | SELL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="195" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Backtester -->
        <mxCell id="backtest" value="&lt;b&gt;Backtester + metrics&lt;/b&gt;&lt;br&gt;daily decisions vs QQQ buy-and-hold&lt;br&gt;return, Sharpe, max drawdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="80" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- LLM layer -->
        <mxCell id="llm" value="LLM layer (Gemini, OpenAI-compatible API)" style="swimlane;fontStyle=1;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="470" width="720" height="190" as="geometry" />
        </mxCell>
        <mxCell id="debate" value="&lt;b&gt;Debate Agent (moderator)&lt;/b&gt;&lt;br&gt;runs only when signals conflict&lt;br&gt;weighs bull vs bear case&lt;br&gt;sets final action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="llm">
          <mxGeometry x="20" y="50" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="explanation" value="&lt;b&gt;Explanation Agent&lt;/b&gt;&lt;br&gt;justifies the final&lt;br&gt;BUY / HOLD / SELL&lt;br&gt;in plain language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="llm">
          <mxGeometry x="255" y="50" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;Report Agent&lt;/b&gt;&lt;br&gt;explains backtest results&lt;br&gt;(returns, Sharpe, drawdown)&lt;br&gt;vs buy-and-hold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="llm">
          <mxGeometry x="490" y="50" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- Outputs -->
        <mxCell id="outputs" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;FastAPI /analysis and /backtest&lt;br&gt;Streamlit dashboard&lt;br&gt;data/llm_report.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="800" y="730" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;Rule-based agents drive the daily backtest, so results are deterministic.&lt;br&gt;LLM agents run once per analysis, never inside the backtest loop.&lt;br&gt;If the LLM is unavailable, the rule-based decision is kept." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="460" height="100" as="geometry" />
        </mxCell>

        <!-- Data to analysts -->
        <mxCell id="e-data" value="price history" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data" target="analysts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Analysts to blackboard -->
        <mxCell id="e-tech" value="write" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="technical" target="blackboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sent" value="write" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sentiment" target="blackboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-risk" value="write" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="risk" target="blackboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Blackboard to decision -->
        <mxCell id="e-read" value="read signals" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="blackboard" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision to backtester -->
        <mxCell id="e-backtest" value="daily actions" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="decision" target="backtest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Blackboard to debate -->
        <mxCell id="e-debate" value="structured signals&lt;br&gt;+ rule decision" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="blackboard" target="debate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Debate to explanation -->
        <mxCell id="e-final" value="final action" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="debate" target="explanation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backtester to report -->
        <mxCell id="e-metrics" value="metrics" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="backtest" target="report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LLM agents to outputs -->
        <mxCell id="e-out-explain" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="explanation" target="outputs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-out-report" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="report" target="outputs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
